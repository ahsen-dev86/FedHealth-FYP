# Build: docker build -f "Module 4 FL/Dockerfile.client" -t fedhealth-fl-client .
FROM python:3.13-slim
WORKDIR /app
COPY ["Module 4 FL/requirements.txt", "/tmp/requirements.txt"]
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt
COPY ["Module 3 ML/schema.py", "Module 3 ML/preprocess.py", "Module 3 ML/models.py", "Module 3 ML/rules.py", "/app/Module 3 ML/"]
COPY ["Module 4 FL/", "/app/module4/"]
WORKDIR /app/module4
ENV PYTHONPATH=/app/module4
ENV FL_SERVER=fl-server:8080 LAB_ID=lab-00 LOCAL_EPOCHS=1 FL_CANONICAL_UNITS=1
ENV SHARD_CSV=/data/lab_00.csv PREPROCESSOR=/artifacts/reference/preprocessor.joblib
ENV FL_CA_CERT=/certs/ca.crt
VOLUME ["/artifacts", "/data", "/certs"]
CMD ["python", "client.py"]
