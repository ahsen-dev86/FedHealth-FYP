# docker-compose environment. Copy to .env and edit.

# --- Database (superuser used for init + the app role's grants) ---
POSTGRES_DB=fedhealth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- App DB role (created by db/seed/seed.sql). If you change the password in
#     seed.sql, change it here too. ---
APP_DB_USER=fedhealth_app
APP_DB_PASSWORD=change_me_in_prod

# --- Auth: CHANGE THIS to a long random string for anything real ---
JWT_SECRET=dev-insecure-secret-change-me

# --- Federation demo (docker compose --profile federation up) ---
FL_ROUNDS=5
FL_LABS=3
