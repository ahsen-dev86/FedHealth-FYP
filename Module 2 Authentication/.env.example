# backend/.env.example  — copy to backend/.env and adjust.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL (app connects as the least-privilege fedhealth_app role) ---
PGHOST=localhost
PGPORT=5432
PGUSER=fedhealth_app
PGPASSWORD=change_me_in_prod
PGDATABASE=fedhealth
PG_POOL_MAX=10

# --- Auth / JWT ---
# MUST be a long random string in production (app refuses to boot otherwise).
JWT_SECRET=dev-insecure-secret-change-me
JWT_ISSUER=fedhealth
JWT_ACCESS_TTL=2h
JWT_PREAUTH_TTL=5m

# --- Password hashing (bcrypt cost factor) ---
BCRYPT_ROUNDS=12

# --- MFA (TOTP) ---
TOTP_ISSUER=FedHealth
TOTP_WINDOW=1

# --- Login lockout policy ---
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
