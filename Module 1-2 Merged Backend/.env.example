# backend/.env.example — copy to backend/.env and adjust.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL (app connects as the least-privilege fedhealth_app role) ---
PGHOST=localhost
PGPORT=5432
PGUSER=fedhealth_app
PGPASSWORD=change_me_in_prod
PGDATABASE=fedhealth
PG_POOL_MAX=10

# --- Auth / JWT ---
# MUST be a long random string in production (app refuses to boot otherwise).
JWT_SECRET=dev-insecure-secret-change-me
JWT_ISSUER=fedhealth
JWT_ACCESS_TTL=2h
JWT_PREAUTH_TTL=5m

# --- Password hashing ---
BCRYPT_ROUNDS=12

# --- TOTP / MFA ---
TOTP_ISSUER=FedHealth
TOTP_WINDOW=1

# --- Brute-force lockout ---
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# --- Patient pseudonymization (src/models/pseudonymize.js) ---
# Generate with: openssl rand -hex 32
# Rotating this makes all previously-issued patient_ref tokens unlinkable
# to new ones — a deliberate, disruptive operation, not routine maintenance.
PATIENT_REF_HMAC_KEY=change_me_generate_a_real_random_secret

# --- Express trust proxy: 'loopback' (Vite dev proxy), a hop count, or CIDRs ---
TRUST_PROXY=loopback

# --- Inference service (Module 6 Domain API/app.py) ---
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_TIMEOUT_MS=20000
# Same random value as the inference service's INFERENCE_API_KEY (openssl rand -hex 24).
INFERENCE_API_KEY=change_me_generate_a_real_random_secret

# --- NIH outbreak-cluster alerting ---
ALERT_CLUSTER_WINDOW_DAYS=7
ALERT_CLUSTER_MIN_CASES=3

# --- No single point of failure: backup inference replica ---
# A second inference process serving an independently trained bundle (seed 52).
# When the primary is unreachable, times out or has no model, requests go here.
INFERENCE_FALLBACK_URL=http://127.0.0.1:8001
# After a primary fault, go straight to the backup for this long (ms).
INFERENCE_BREAKER_MS=15000

# --- Speech-to-text for symptom dictation (local Whisper) ---
SPEECH_URL=http://127.0.0.1:8002
SPEECH_TIMEOUT_MS=120000

# --- Federated-learning demonstration (Model Health → Federated training (demo)) ---
# A demonstration only: runs never change the real model. Set to off to remove
# it from a server, e.g. once real lab devices run the federation.
FEDERATION_DEMO=on

# --- Sign-up proof review: accounts stay locked until an admin approves their document ---
REQUIRE_PROOF_APPROVAL=true

# --- Hardening ---
# Browser origins allowed to call the API (comma-separated). Required in production.
CORS_ORIGINS=
# Requests per IP per minute across the API; credential attempts per IP per 15 minutes.
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# --- Image OCR (tesseract; the Windows installer path is found automatically) ---
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
